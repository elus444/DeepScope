# Supabase project (Settings -> API). The anon key is safe to use here --
# it's the same public key the frontend uses; Postgres Row Level Security
# is what actually scopes every query to the calling user, not this key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Gemini API key (https://aistudio.google.com/apikey) -- used for
# both embeddings and the LLM agents. Required for the /documents upload
# endpoint and its RLS isolation test; not required for the rest of the
# test suite (citations, auth-header validation, chat-session isolation).
GEMINI_API_KEY=your-gemini-api-key
