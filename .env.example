# ==========================
# Backend Configuration
# ==========================

# Gemini API Key (required) -- get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini models
EMBEDDING_MODEL=gemini-embedding-2
LLM_MODEL=gemini-3.6-flash

# Supabase project (Postgres + pgvector + Auth) -- from Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend port (Render sets this automatically)
BACKEND_PORT=8000

# Frontend URL for CORS (set after deploying frontend to Vercel)
# Example: https://deepscope.vercel.app
FRONTEND_URL=http://localhost:3000

# ==========================
# Frontend Configuration
# ==========================

# Backend API URL (set after deploying backend to Render)
# Example: https://deepscope-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Same Supabase project as the backend -- the anon key is safe to expose
# to the browser, RLS is what actually enforces access control.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
