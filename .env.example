# ==========================
# Backend Configuration
# ==========================

# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Vector database path
VECTOR_DB_PATH=./backend/db/documents

# OpenAI models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Backend port (Render sets this automatically)
BACKEND_PORT=8000

# Frontend URL for CORS (set after deploying frontend to Vercel)
# Example: https://deepscope.vercel.app
FRONTEND_URL=http://localhost:3000

# ==========================
# Frontend Configuration
# ==========================

# Backend API URL (set after deploying backend to Render)
# Example: https://deepscope-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
