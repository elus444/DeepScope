# ==========================
# Backend Configuration
# ==========================

# Gemini API Key (required) -- get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vector database path
VECTOR_DB_PATH=./backend/db/documents

# Gemini models
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.5-flash

# Backend port (Render sets this automatically)
BACKEND_PORT=8000

# Frontend URL for CORS (set after deploying frontend to Vercel)
# Example: https://deepscope.vercel.app
FRONTEND_URL=http://localhost:3000

# ==========================
# Frontend Configuration
# ==========================

# Backend API URL (set after deploying backend to Render)
# Example: https://deepscope-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
